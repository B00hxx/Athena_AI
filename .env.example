# ─── Required ────────────────────────────────────────────────────────────────
# Postgres password (used by the db container and by the backend)
DB_PASSWORD=change-me
# JWT signing key. Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# ─── LLM (Ollama) ────────────────────────────────────────────────────────────
# Any chat model from https://ollama.com/library (pulled automatically on first start)
OLLAMA_MODEL=gemma:7b
# Context window (tokens) for each request: retrieved passages + chat history + answer
# OLLAMA_NUM_CTX=8192

# ─── RAG pipeline ────────────────────────────────────────────────────────────
# marker  = layout-aware Markdown with OCR (accurate; slower, especially on CPU)
# pdftext = plain text layer extraction (fast; no OCR, no headings)
# PDF_PARSER=marker
# RETRIEVAL_TOP_K=5
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# MAX_UPLOAD_MB=10

# ─── Ports (Docker) ──────────────────────────────────────────────────────────
# APP_PORT=3000     # web app
# API_PORT=8000     # backend + Swagger UI (bound to localhost)
# DB_PORT=5433      # Postgres (bound to localhost)

# ─── Local development only (./start.sh, backend running on the host) ───────
# Defaults point at the Docker db/ollama on localhost; override to use your own.
# DATABASE_URL=postgresql://athena_user:change-me@localhost:5433/athena_db
# OLLAMA_HOST=http://localhost:11434
